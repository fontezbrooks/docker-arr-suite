# Gluetun VPN settings.
# Choose a provider before torrenting and update these values using:
# https://github.com/qdm12/gluetun-wiki
VPN_SERVICE_PROVIDER=
VPN_TYPE=openvpn
TZ=Etc/UTC

# OpenVPN credentials come from Docker secrets.
OPENVPN_USER_SECRETFILE=/run/secrets/openvpn_user
OPENVPN_PASSWORD_SECRETFILE=/run/secrets/openvpn_password

# Enable only if your chosen VPN provider supports port forwarding.
VPN_PORT_FORWARDING=on
UPDATER_PERIOD=24h

# Required by qBittorrent port-forward helper once provider/auth is configured.
HTTP_CONTROL_SERVER_ADDRESS=:8000

# qBittorrent
PUID=1000
PGID=1000
TZ=Etc/UTC
WEBUI_PORT=8088

# qBittorrent Port Forwarder (profile: portforward)
# This image reads credentials from the environment only; it does not support
# Docker secret files. Keep these in sync with the qBittorrent Web UI login.
QBT_USERNAME=admin
QBT_PASSWORD=changeme
QBT_ADDR=http://gluetun:8088
GTN_ADDR=http://gluetun:8000
